    "title_de": "Nominalisierung",
    "cefr_labels": [
      "C1"
    ],
    "short_explanation_de": "Sätze und verbale Strukturen werden zu kompakten Nominalgruppen umgeformt.",
    "explanation_de": "Nominalisierung macht aus Handlungen und Prozessen nominale Ausdrücke. Dadurch können Informationen verdichtet und besonders in formellen schriftlichen Texten kompakt kombiniert werden. Bei der Umformung ändern sich grammatische Rollen systematisch.",
    "explanation_fa": "در اسمی‌سازی، عمل‌ها و فرایندها به عبارت‌های اسمی تبدیل می‌شوند. این کار اطلاعات را فشرده‌تر می‌کند و مخصوصاً در متن‌های رسمی نوشتاری رایج است. هنگام تبدیل، نقش‌های دستوری به‌صورت منظم تغییر می‌کنند.",
    "learning_goals": [
      "verbale Aussagen als Nominalgruppen formulieren",
      "Subjekt- und Objektrollen bei der Nominalisierung korrekt umformen",
      "Präpositionalobjekte, Pronomen und Adverbien passend übertragen",
      "Nebensatz- und Modalbedeutungen nominal ausdrücken",
      "Nominalstil gezielt in formellen Texten verwenden"
    ],
    "rules": [
      {
        "rule_id": "ga-b2c1-ch082-r1",
        "statement_de": "Bei der Nominalisierung wird eine Handlung oder ein Prozess als Nomen beziehungsweise Nominalgruppe ausgedrückt.",
        "explanation_fa": "در اسمی‌سازی، یک عمل یا فرایند به‌صورت اسم یا گروه اسمی بیان می‌شود.",
        "scope": "Grundprinzip der Nominalisierung",
        "positive_examples": [
          "die Nutzung digitaler Werkzeuge",
          "die schnelle Veränderung des Marktes",
          "die Ankunft des Zuges"
        ],
        "exception_ids": [
          "ga-b2c1-ch082-ex1"
        ],
        "source_refs": [
