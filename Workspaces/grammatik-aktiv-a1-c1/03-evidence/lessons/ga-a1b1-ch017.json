          }
        ],
        "origin_type": "SOURCE_ADAPTED"
      },
      {
        "rule_id": "ga-a1b1-ch017-r3",
        "statement_de": "Im Dativ Plural steht häufig zusätzlich -n am Nomen; Pluralformen auf -s erhalten kein zusätzliches -n.",
        "explanation_fa": "در جمع داتیو معمولاً -n به اسم اضافه می‌شود؛ جمع‌هایی که به -s ختم می‌شوند -n اضافی نمی‌گیرند.",
        "scope": "Dativ Plural",
