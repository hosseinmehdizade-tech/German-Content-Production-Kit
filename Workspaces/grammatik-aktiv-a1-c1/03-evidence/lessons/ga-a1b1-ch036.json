    "title_de": "Ein netter Mann! Ich liebe den netten Mann",
    "cefr_labels": [
      "A2"
    ],
    "short_explanation_de": "Adjektivendungen im Nominativ und Akkusativ.",
    "explanation_de": "Das Kapitel führt Adjektivendungen vor Nomen im Nominativ und Akkusativ ein. Es arbeitet mit dem Prinzip, dass Genus, Numerus und Kasus durch ein sichtbares Signal am Artikel oder am Adjektiv markiert werden.",
    "explanation_fa": "این فصل پایان‌های صفت پیش از اسم را در Nominativ و Akkusativ معرفی می‌کند. اصل محوری این است که جنس، شمار و حالت دستوری با یک نشانهٔ قابل‌مشاهده روی Artikel یا صفت مشخص می‌شوند.",
    "learning_goals": [
      "Adjektivendungen im Nominativ bilden",
      "Adjektivendungen im Akkusativ bilden",
      "bestimmten und unbestimmten Artikel als Signal nutzen",
      "Adjektive nach dem Nomen unflektiert verwenden"
    ],
    "rules": [
      {
        "rule_id": "ga-a1b1-ch036-r1",
        "statement_de": "Ein Adjektiv links vom Nomen hat mindestens die Endung -e; die genaue Endung hängt von Artikel, Genus, Numerus und Kasus ab.",
        "explanation_fa": "صفتی که پیش از اسم می‌آید دست‌کم پایان -e دارد؛ پایان دقیق به Artikel، جنس، شمار و حالت دستوری بستگی دارد.",
        "scope": "attributives Adjektiv",
        "positive_examples": [
          "der nette Mann",
          "ein netter Mann",
          "das nette Kind",
          "eine nette Frau"
        ],
        "exception_ids": [],
        "source_refs": [
          {
            "source_id": "grammatik-aktiv-a1-b1",
            "printed_page": 88,
            "pdf_page": 86,
            "locator_note": "Kapitel 36: Grundprinzip Adjektiv links vom Nomen"
          }
        ],
        "origin_type": "SOURCE_ADAPTED"
      },
      {
        "rule_id": "ga-a1b1-ch036-r2",
        "statement_de": "Im Akkusativ Maskulin hat das attributive Adjektiv in den gezeigten Mustern die Endung -en.",
        "explanation_fa": "در Akkusativ مذکر، صفت پیش از اسم در الگوهای نشان‌داده‌شده پایان -en می‌گیرد.",
        "scope": "Akkusativ maskulin",
        "positive_examples": [
          "den netten Mann",
          "einen netten Mann",
          "keinen netten Mann"
        ],
        "exception_ids": [],
