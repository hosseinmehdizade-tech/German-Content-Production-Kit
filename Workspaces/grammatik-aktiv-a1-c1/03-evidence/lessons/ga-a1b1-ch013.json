    "rules": [
      {
        "rule_id": "ga-a1b1-ch013-r1",
        "statement_de": "Deutsche Nomen bilden den Plural mit unterschiedlichen Mustern wie -(e)n, -er, -e, -s oder ohne zusätzliche Endung; teilweise kommt Umlaut hinzu.",
        "explanation_fa": "اسم‌های آلمانی جمع را با الگوهای مختلف مانند -(e)n، -er، -e، -s یا بدون پسوند تازه می‌سازند و گاهی Umlaut هم اضافه می‌شود.",
        "scope": "Pluralbildung",
        "positive_examples": [
          "die Frau – die Frauen",
          "das Kind – die Kinder",
          "der Stuhl – die Stühle"
        ],
        "exception_ids": [],
