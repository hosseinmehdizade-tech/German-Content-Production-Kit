          }
        ],
        "origin_type": "SOURCE_ADAPTED"
      },
      {
        "rule_id": "ga-a1b1-ch007-r3",
        "statement_de": "Im Nebensatz steht das trennbare Verb am Ende wieder zusammengeschrieben beziehungsweise ungetrennt.",
        "explanation_fa": "در جملهٔ وابسته، فعل جداشدنی در پایان دوباره به‌صورت یکپارچه می‌آید.",
