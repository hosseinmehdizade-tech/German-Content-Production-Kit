{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gfp.local/schemas/german-language-content-v3.1.3.schema.json",
  "title": "German Language Canonical Content Dataset v3.1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "profile_id",
    "learning_units"
  ],
  "properties": {
    "contract_version": {
      "const": "3.1.3"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "learning_units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/learningUnit"
      }
    }
  },
  "$defs": {
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "text"
      ],
      "properties": {
        "lang": {
          "$ref": "#/$defs/languageTag"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lang",
        "text",
        "order",
        "translations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "$ref": "#/$defs/languageTag"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "sense_id": {
          "type": "string",
          "pattern": "^sense-[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "translations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/translation"
          }
        }
      }
    },
    "sense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sense-[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "meaning_fa": {
          "type": "string",
          "minLength": 1
        },
        "gloss_en": {
          "type": "string",
          "minLength": 1
        },
        "definition_de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "unit_order": {
          "type": "integer",
          "minimum": 1
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retired_example_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_kind",
        "what_was_verified",
        "verification_status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_kind": {
          "enum": [
            "book",
            "course",
            "lexicon",
            "corpus",
            "website",
            "expert",
            "generated",
            "other"
          ]
        },
        "what_was_verified": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "architecture_fixture",
              "german_sense",
              "german_definition",
              "orthography",
              "grammar",
              "rection",
              "morphology",
              "usage",
              "register",
              "collocation",
              "synonymy",
              "antonymy",
              "word_family",
              "frequency",
              "corpus_usage",
              "etymology",
              "bilingual_sense_match",
              "persian_gloss",
              "persian_wording",
              "persian_example_translation",
              "english_gloss",
              "english_wording",
              "english_example_translation",
              "example_attestation"
            ]
          }
        },
        "verification_status": {
          "enum": [
            "verified",
            "unverified",
            "blocked",
            "not_found"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "accessed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "evidence_note": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "risk_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ambiguous_sense",
              "multi_sense",
              "disputed",
              "high_risk"
            ]
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "learningUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "headword",
        "core",
        "examples",
        "metadata",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "headword": {
          "type": "string",
          "minLength": 1
        },
        "persian_meaning": {
          "type": "string",
          "minLength": 1
        },
        "english_gloss": {
          "type": "string",
          "minLength": 1
        },
        "definition_de": {
          "type": "string",
          "minLength": 1
        },
        "senses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sense"
          }
        },
        "core": {
          "type": "object"
        },
        "details": {
          "type": "object"
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "https://gfp.local/schemas/connection-v1.schema.json"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  }
}
