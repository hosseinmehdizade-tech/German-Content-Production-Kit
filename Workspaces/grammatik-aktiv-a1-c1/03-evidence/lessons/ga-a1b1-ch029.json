      {
        "rule_id": "ga-a1b1-ch029-r4",
        "statement_de": "Reflexive Verben bilden das Perfekt mit haben.",
        "explanation_fa": "فعل‌های بازتابی Perfekt را با haben می‌سازند.",
        "scope": "Perfekt reflexiver Verben",
        "positive_examples": [
          "Er hat sich geärgert.",
          "Wir haben uns gefreut."
        ],
        "exception_ids": [],
        "source_refs": [
