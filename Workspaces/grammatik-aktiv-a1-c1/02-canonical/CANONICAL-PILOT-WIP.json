    {
      "concept_id": "grammar.nominalisierung",
      "canonical_title_de": "Nominalisierung und Verdichtung",
      "topic_family": "TRANSFORMATION_AND_REGISTER",
      "cefr_min": "C1",
      "cefr_max": "C1",
