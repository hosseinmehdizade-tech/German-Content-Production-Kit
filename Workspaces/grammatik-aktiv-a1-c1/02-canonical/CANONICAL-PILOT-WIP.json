  "concepts": [
    {
      "concept_id": "grammar.verbkonjugation.praesens_regular",
      "canonical_title_de": "Regelmäßige Verbkonjugation im Präsens",
      "topic_family": "VERB_CONJUGATION",
      "cefr_min": "A1",
      "cefr_max": "A1",
      "prerequisite_concept_ids": [],
      "related_concept_ids": ["grammar.verbkonjugation.praesens_stammwechsel"],
      "source_chapter_ids": ["ga-a1b1-ch002"],
      "skill_tags": ["praesens", "konjugation", "personenendungen", "form_building"],
      "source_supported_core": {
        "rules": [
          {
            "rule_key": "person_number_endings",
            "statement_de": "Im Präsens markieren die Endungen Person und Numerus: ich -e, du -st, er/sie/es -t, wir -en, ihr -t, sie/Sie -en.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "stem_ending_adjustment",
            "statement_de": "Bei bestimmten Verbstämmen wird die Endung lautlich oder orthografisch angepasst; solche Formen werden als Musterhinweis am Konjugationsschema geführt.",
            "origin_type": "SOURCE_ADAPTED"
          }
        ],
        "pattern_types": ["CONJUGATION"],
        "exercise_types_needed": ["FILL_GAP", "FORM_BUILDING", "SHORT_ANSWER"]
      }
    },
    {
      "concept_id": "grammar.wechselpraepositionen.wo_wohin",
      "canonical_title_de": "Wechselpräpositionen: Wo? und Wohin?",
      "topic_family": "PREPOSITIONS_AND_CASE",
      "cefr_min": "A2",
      "cefr_max": "A2",
      "prerequisite_concept_ids": ["grammar.kasus.dativ", "grammar.kasus.akkusativ"],
      "related_concept_ids": ["grammar.positions_und_direktionsverben"],
      "source_chapter_ids": ["ga-a1b1-ch034"],
      "skill_tags": ["wechselpraepositionen", "dativ", "akkusativ", "wo", "wohin", "case_selection"],
      "source_supported_core": {
        "rules": [
          {
            "rule_key": "direction_accusative",
            "statement_de": "Bei einer gerichteten Bewegung mit den Wechselpräpositionen beantwortet die Struktur die Frage Wohin? und steht mit Akkusativ.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "location_dative",
            "statement_de": "Bei einer Ortsangabe mit den Wechselpräpositionen beantwortet die Struktur die Frage Wo? und steht mit Dativ.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "core_prepositions",
            "statement_de": "Zum Kernset gehören in, an, auf, über, unter, vor, hinter, neben und zwischen.",
            "origin_type": "SOURCE_DERIVED"
          }
        ],
        "pattern_types": ["CASE_MATRIX", "TRANSFORMATION"],
        "pattern_notes": ["in das → ins", "in dem → im", "an das → ans", "an dem → am"],
        "exercise_types_needed": ["CASE_SELECTION", "FILL_GAP", "MATCHING", "SHORT_ANSWER"]
      }
    },
    {
      "concept_id": "grammar.relativsaetze.nominativ",
      "canonical_title_de": "Relativsätze mit Relativpronomen im Nominativ",
      "topic_family": "SUBORDINATE_CLAUSES",
      "cefr_min": "B1",
      "cefr_max": "B1",
      "prerequisite_concept_ids": ["grammar.nebensatz.verb_final"],
      "related_concept_ids": ["grammar.relativsaetze.akkusativ_dativ", "grammar.relativsaetze.genitiv"],
      "source_chapter_ids": ["ga-a1b1-ch070"],
      "skill_tags": ["relativsatz", "relativpronomen", "nominativ", "verb_final", "sentence_combination"],
      "source_supported_core": {
        "rules": [
          {
            "rule_key": "relative_clause_verb_final",
            "statement_de": "Der Relativsatz ist ein Nebensatz; das konjugierte Verb steht am Ende.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "relative_pronoun_agreement",
            "statement_de": "Das Relativpronomen richtet sich in Genus und Numerus nach dem Bezugswort; sein Kasus ergibt sich aus seiner Funktion im Relativsatz.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "relative_clause_attachment",
            "statement_de": "Der Relativsatz steht typischerweise direkt beim Bezugswort und kann dadurch innerhalb des Hauptsatzes eingeschoben sein.",
            "origin_type": "SOURCE_ADAPTED"
          }
        ],
        "pattern_types": ["DECLENSION", "WORD_ORDER"],
        "exercise_types_needed": ["MATCHING", "ORDER_SENTENCE", "TRANSFORM_SENTENCE", "SHORT_ANSWER"]
      }
    },
    {
      "concept_id": "grammar.verbposition.einfache_saetze",
      "canonical_title_de": "Verbposition in einfachen Sätzen",
      "topic_family": "WORD_ORDER",
      "cefr_min": "B2",
      "cefr_max": "C1",
      "prerequisite_concept_ids": ["grammar.hauptsatz.verb_zweit"],
      "related_concept_ids": ["grammar.satzklammer", "grammar.verbposition.satzverbindungen"],
      "source_chapter_ids": ["ga-b2c1-ch001"],
      "skill_tags": ["verbposition", "satzklammer", "position_1", "position_2", "verb_first", "word_order"],
      "source_supported_core": {
        "rules": [
          {
            "rule_key": "finite_verb_position_2",
            "statement_de": "Im Aussagesatz und in der W-Frage steht das konjugierte Verb auf Position 2.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "sentence_bracket",
            "statement_de": "Ein zweiter Verbteil oder Verbbaustein kann am Satzende stehen und mit dem finiten Verb die Satzklammer bilden.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "position_1_constituent",
            "statement_de": "Auf Position 1 steht genau ein Satzteil, der aus einem oder mehreren Wörtern bestehen kann; danach folgt das finite Verb.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "verb_first_types",
            "statement_de": "Ja/Nein-Fragen, Imperativsätze sowie bestimmte uneingeleitete irreale Wunsch- und Konditionalsätze beginnen mit dem konjugierten Verb.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "postfield",
            "statement_de": "Bestimmte Satzteile können nach dem zweiten Verbteil ins Nachfeld verschoben werden.",
            "origin_type": "SOURCE_ADAPTED"
          }
        ],
        "pattern_types": ["WORD_ORDER", "CONNECTOR_POSITION"],
        "exercise_types_needed": ["ORDER_SENTENCE", "TRANSFORM_SENTENCE", "ERROR_CORRECTION", "SHORT_ANSWER"]
      }
    },
    {
      "concept_id": "grammar.passiv.vorgangspassiv.zeiten",
      "canonical_title_de": "Vorgangspassiv in den Zeiten",
      "topic_family": "VOICE_AND_TENSE",
      "cefr_min": "B2",
      "cefr_max": "C1",
