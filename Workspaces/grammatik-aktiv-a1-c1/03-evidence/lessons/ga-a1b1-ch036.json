          }
        ],
        "origin_type": "SOURCE_ADAPTED"
      },
      {
        "rule_id": "ga-a1b1-ch036-r3",
        "statement_de": "Im Plural hat das Adjektiv mit den gezeigten Artikelwörtern die Endung -en; ohne Artikel steht im Nominativ und Akkusativ die Form auf -e.",
        "explanation_fa": "در جمع، صفت با Artikelهای نشان‌داده‌شده پایان -en می‌گیرد؛ بدون Artikel در Nominativ و Akkusativ شکل -e می‌آید.",
        "scope": "Plural",
