      "source_chapter_ids": ["ga-b2c1-ch082"],
      "skill_tags": ["nominalisierung", "transformation", "nominalstil", "verdichtung", "formal_register"],
      "source_supported_core": {
        "rules": [
          {
            "rule_key": "purpose_condensation",
            "statement_de": "Durch Nominalisierung werden Handlungen und Prozesse als Nominalgruppen ausgedrückt; dadurch lassen sich Informationen besonders in formellen Textsorten verdichten.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "argument_remapping",
            "statement_de": "Bei der Umformung werden Satzglieder systematisch in Genitiv-, Präpositional- oder Possessivstrukturen der Nominalgruppe überführt.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "subject_object_transitive",
            "statement_de": "Bei transitiven Strukturen kann das frühere Akkusativobjekt als Genitivattribut erscheinen; der frühere Handelnde kann mit durch + Akkusativ ausgedrückt werden.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "prepositional_object_preservation",
            "statement_de": "Eine feste Präpositionalergänzung bleibt bei der Nominalisierung grundsätzlich als Präpositionalergänzung erhalten.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "connector_to_preposition",
            "statement_de": "Nebensatzkonnektoren können bei der Nominalisierung durch passende Präpositionen ersetzt werden.",
            "origin_type": "SOURCE_ADAPTED"
          }
        ],
        "pattern_types": ["TRANSFORMATION", "DECLENSION"],
        "exercise_types_needed": ["TRANSFORM_SENTENCE", "FORM_BUILDING", "ERROR_CORRECTION", "FREE_PRODUCTION"]
      }
    }
