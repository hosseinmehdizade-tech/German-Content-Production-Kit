{"source_chapter_id":"ga-a1b1-ch015","source_book_id":"grammatik-aktiv-a1-b1","source_hash":"aeb7625f628105204590b20870a03e92648d49366d12b478412228c8078e4207","status":"EVIDENCE_LINKED_DRAFT","lesson":{"lesson_id":"lesson.ga-a1b1-ch015","source_chapter_id":"ga-a1b1-ch015","concept_ids":["grammar.negation.kein_nicht_nie"],"title_de":"Kein, nicht, nie","cefr_labels":["A1"],"short_explanation_de":"Grundformen der Negation.","explanation_de":"Das Kapitel unterscheidet kein und nicht und erweitert die Negation um häufige Wörter wie nie, niemand, nichts, nicht mehr und noch nicht.","explanation_fa":"این فصل kein و nicht را از هم جدا می‌کند و واژه‌های منفی رایجی مانند nie، niemand، nichts، nicht mehr و noch nicht را اضافه می‌کند.","learning_goals":["kein und nicht unterscheiden","weitere Negationswörter verwenden"],"rules":[{"rule_id":"ga-a1b1-ch015-r1","statement_de":"kein verneint Nomen und wird wie ein Artikel vor dem Nomen verwendet.","explanation_fa":"kein اسم را منفی می‌کند و مانند حرف تعریف پیش از اسم می‌آید.","scope":"Negation mit kein","positive_examples":["Ich habe kein Buch.","Sie hat keine Zeit.","Wir haben kein Auto."],"exception_ids":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":40,"pdf_page":38,"locator_note":"Kapitel 15: kein vor Nomen"}],"origin_type":"SOURCE_ADAPTED"},{"rule_id":"ga-a1b1-ch015-r2","statement_de":"nicht verneint andere Satzteile oder den Satz und steht nicht als Artikel vor einem Nomen.","explanation_fa":"nicht سایر اجزای جمله یا کل جمله را منفی می‌کند و نقش حرف تعریف پیش از اسم ندارد.","scope":"Negation mit nicht","positive_examples":["Ich bin nicht verheiratet.","Ich wohne nicht in Berlin.","Ich arbeite heute nicht."],"exception_ids":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":40,"pdf_page":38,"locator_note":"Kapitel 15: nicht"}],"origin_type":"SOURCE_ADAPTED"},{"rule_id":"ga-a1b1-ch015-r3","statement_de":"Weitere Negationsausdrücke sind unter anderem nie, niemand, nichts, ohne, nicht mehr, noch nicht und noch nie.","explanation_fa":"عبارت‌های منفی دیگر شامل nie، niemand، nichts، ohne، nicht mehr، noch nicht و noch nie هستند.","scope":"weitere Negationswörter","positive_examples":["Ich war noch nie in Japan.","Niemand ist da.","Ich arbeite heute nicht mehr."],"exception_ids":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":40,"pdf_page":38,"locator_note":"Kapitel 15: weitere Negationswörter"},{"source_id":"grammatik-aktiv-a1-b1","printed_page":41,"pdf_page":39,"locator_note":"Kapitel 15 Übungen"}],"origin_type":"SOURCE_ADAPTED"}],"patterns":[{"pattern_id":"ga-a1b1-ch015-p1","pattern_type":"COMPARISON","title_de":"kein oder nicht","columns":["Form","typischer Gebrauch"],"rows":[["kein/keine","vor einem Nomen"],["nicht","Satz/Verb/Adjektiv/Präpositionalgruppe"],["nie / noch nie","Zeit/Frequenz"],["niemand / nichts","Person / Sache"]],"notes_de":[],"notes_fa":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":40,"pdf_page":38,"locator_note":"Kapitel 15 Übersicht"}]}],"examples":[{"example_id":"ga-a1b1-ch015-e1","text_de":"Ich habe keinen Termin.","translation_fa":"وقت ملاقات ندارم.","concept_ids":["grammar.negation.kein_nicht_nie"],"rule_ids":["ga-a1b1-ch015-r1"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":40,"pdf_page":38,"locator_note":"ga-a1b1-ch015: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch015-e2","text_de":"Er wohnt nicht in München.","translation_fa":"او در مونیخ زندگی نمی‌کند.","concept_ids":["grammar.negation.kein_nicht_nie"],"rule_ids":["ga-a1b1-ch015-r2"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":40,"pdf_page":38,"locator_note":"ga-a1b1-ch015: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch015-e3","text_de":"Ich habe noch nie Sushi gegessen.","translation_fa":"من تا حالا سوشی نخورده‌ام.","concept_ids":["grammar.negation.kein_nicht_nie"],"rule_ids":["ga-a1b1-ch015-r3"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":41,"pdf_page":39,"locator_note":"ga-a1b1-ch015: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"}],"exceptions":[],"common_errors":[{"error_id":"ga-a1b1-ch015-ce1","wrong_example_de":"Ich habe nicht Auto.","correct_example_de":"Ich habe kein Auto.","explanation_de":"Ein Nomen ohne bestimmten Artikel wird hier mit kein verneint.","explanation_fa":"اسم در اینجا با kein منفی می‌شود.","skill_tags":["negation"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":40,"pdf_page":38,"locator_note":"Kapitel 15 kein/nicht"}],"origin_type":"GENERATED"}],"exercise_ids":["ga-a1b1-ch015-x1","ga-a1b1-ch015-x2"],"speaking_tasks":[],"linked_object_ids":[],"prerequisite_lesson_ids":[],"provenance":{"primary_source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":40,"pdf_page":38,"locator_note":"ga-a1b1-ch015: printed source page 40"},{"source_id":"grammatik-aktiv-a1-b1","printed_page":41,"pdf_page":39,"locator_note":"ga-a1b1-ch015: printed source page 41"}],"source_hash":"aeb7625f628105204590b20870a03e92648d49366d12b478412228c8078e4207","source_first":true},"qa_status":"EVIDENCE_LINKED_DRAFT"},"exercises":[{"exercise_id":"ga-a1b1-ch015-x1","lesson_id":"lesson.ga-a1b1-ch015","exercise_type":"FILL_GAP","prompt_de":"Ergänzen Sie kein oder nicht.","answer_spec":{"mode":"negation_choice"},"feedback_rules":["Nomenbezug prüfen"],"skill_tags":["negation"],"target_object_ids":["ga-a1b1-ch015-p1"],"difficulty":"A1","source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":40,"pdf_page":38,"locator_note":"Kapitel 15 Übungen"}],"origin_type":"SOURCE_ADAPTED"},{"exercise_id":"ga-a1b1-ch015-x2","lesson_id":"lesson.ga-a1b1-ch015","exercise_type":"MULTIPLE_CHOICE","prompt_de":"Wählen Sie das passende Negationswort.","answer_spec":{"mode":"single_choice"},"feedback_rules":["Bedeutung Zeit/Person/Sache 