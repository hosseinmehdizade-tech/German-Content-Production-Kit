      "source_supported_core": {
        "rules": [
          {
            "rule_key": "passive_focus",
            "statement_de": "Das Vorgangspassiv wird verwendet, wenn die Handlung im Vordergrund steht; der Handelnde kann ungenannt bleiben.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "active_object_to_passive_subject",
            "statement_de": "Bei der Aktiv-Passiv-Transformation wird das Akkusativobjekt des Aktivsatzes zum Subjekt des Passivsatzes.",
            "origin_type": "SOURCE_ADAPTED"
          },
          {
            "rule_key": "agent_cause_instrument",
            "statement_de": "Handelnde Personen/Institutionen werden typischerweise mit von + Dativ, Ursache/Vorgang mit durch + Akkusativ und Instrumente mit mit + Dativ ergänzt.",
            "origin_type": "SOURCE_ADAPTED"
          }
        ],
        "pattern_types": ["TENSE_FORMATION", "TRANSFORMATION"],
        "tense_matrix_scope": ["Präsens", "Präteritum", "Perfekt", "Plusquamperfekt", "Futur I", "Futur II", "Konjunktiv II Gegenwart", "Konjunktiv II Vergangenheit", "Konjunktiv I Gegenwart", "Konjunktiv I Vergangenheit"],
