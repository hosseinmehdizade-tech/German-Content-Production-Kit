    "short_explanation_de": "Wörter im Satz 1: Verbposition, Subjekt sowie Zeit und Ort.",
    "explanation_de": "Das Kapitel ordnet die Grundpositionen im deutschen Satz: Verb-zweit im Aussagesatz und in W-Fragen, Verb-erste Position in Ja/Nein-Fragen und Imperativen sowie typische Positionen von Zeit und Ort.",
    "explanation_fa": "این فصل جایگاه‌های پایه در جملهٔ آلمانی را منظم می‌کند: فعل در جایگاه دومِ جملهٔ خبری و پرسش W، جایگاه اول در پرسش بله/خیر و امر، و جایگاه معمول زمان و مکان.",
    "learning_goals": [
      "Verb-zweit im Aussagesatz bilden",
      "Inversion nach Position 1 beherrschen",
      "Zeit- und Ortsangaben sinnvoll positionieren"
    ],
    "rules": [
      {
        "rule_id": "ga-a1b1-ch011-r1",
        "statement_de": "Im Aussagesatz steht das konjugierte Verb auf Position 2.",
        "explanation_fa": "در جملهٔ خبری، فعل صرف‌شده در جایگاه دوم قرار می‌گیرد.",
        "scope": "Aussagesatz",
        "positive_examples": [
          "Ich esse heute Pizza.",
          "Heute esse ich Pizza.",
          "Am Abend essen wir Pizza."
        ],
        "exception_ids": [],
        "source_refs": [
          {
            "source_id": "grammatik-aktiv-a1-b1",
