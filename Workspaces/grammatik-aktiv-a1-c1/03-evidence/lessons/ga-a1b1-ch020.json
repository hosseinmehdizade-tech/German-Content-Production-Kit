{"source_chapter_id":"ga-a1b1-ch020","source_book_id":"grammatik-aktiv-a1-b1","source_hash":"aeb7625f628105204590b20870a03e92648d49366d12b478412228c8078e4207","status":"EVIDENCE_LINKED_DRAFT","lesson":{"lesson_id":"lesson.ga-a1b1-ch020","source_chapter_id":"ga-a1b1-ch020","concept_ids":["grammar.personalpronomen.akkusativ_dativ"],"title_de":"Nur mit dir – nie ohne dich","cefr_labels":["A1"],"short_explanation_de":"Personalpronomen im Akkusativ und Dativ.","explanation_de":"Das Kapitel stellt die Personalpronomen in Nominativ, Akkusativ und Dativ gegenüber und übt ihre Verwendung als Objekte.","explanation_fa":"این فصل ضمیرهای شخصی را در Nominativ، Akkusativ و Dativ کنار هم قرار می‌دهد و کاربرد مفعولی آن‌ها را تمرین می‌کند.","learning_goals":["Akkusativ- und Dativpronomen unterscheiden","passende Objektform wählen"],"rules":[{"rule_id":"ga-a1b1-ch020-r1","statement_de":"Personalpronomen haben im Akkusativ eigene Objektformen: mich, dich, ihn, sie, es, uns, euch, sie, Sie.","explanation_fa":"ضمیرهای شخصی در آکوزاتیو شکل‌های مفعولی ویژه دارند: mich، dich، ihn، sie، es، uns، euch، sie، Sie.","scope":"Akkusativpronomen","positive_examples":["Sie liebt ihn.","Ich sehe dich.","Er besucht uns."],"exception_ids":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":50,"pdf_page":48,"locator_note":"Kapitel 20: Akkusativpronomen"}],"origin_type":"SOURCE_ADAPTED"},{"rule_id":"ga-a1b1-ch020-r2","statement_de":"Im Dativ lauten die Personalpronomen mir, dir, ihm, ihr, ihm, uns, euch, ihnen, Ihnen.","explanation_fa":"شکل‌های داتیو ضمیر شخصی mir، dir، ihm، ihr، ihm، uns، euch، ihnen و Ihnen هستند.","scope":"Dativpronomen","positive_examples":["Er hilft mir.","Ich antworte dir.","Wir danken ihnen."],"exception_ids":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":50,"pdf_page":48,"locator_note":"Kapitel 20: Dativpronomen"}],"origin_type":"SOURCE_ADAPTED"}],"patterns":[{"pattern_id":"ga-a1b1-ch020-p1","pattern_type":"CASE_MATRIX","title_de":"Personalpronomen in drei Kasus","columns":["Nominativ","Akkusativ","Dativ"],"rows":[["ich","mich","mir"],["du","dich","dir"],["er","ihn","ihm"],["sie","sie","ihr"],["es","es","ihm"],["wir","uns","uns"],["ihr","euch","euch"],["sie","sie","ihnen"],["Sie","Sie","Ihnen"]],"notes_de":[],"notes_fa":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":50,"pdf_page":48,"locator_note":"Kapitel 20 Pronomen-Tabelle"}]}],"examples":[{"example_id":"ga-a1b1-ch020-e1","text_de":"Sie sieht ihn jeden Tag.","translation_fa":"او هر روز او را می‌بیند.","concept_ids":["grammar.personalpronomen.akkusativ_dativ"],"rule_ids":["ga-a1b1-ch020-r1"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":50,"pdf_page":48,"locator_note":"ga-a1b1-ch020: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch020-e2","text_de":"Kannst du mir helfen?","translation_fa":"می‌توانی به من کمک کنی؟","concept_ids":["grammar.personalpronomen.akkusativ_dativ"],"rule_ids":["ga-a1b1-ch020-r2"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":50,"pdf_page":48,"locator_note":"ga-a1b1-ch020: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch020-e3","text_de":"Ich mag dich, aber ich antworte dir später.","translation_fa":"دوستت دارم، اما بعداً جوابت را می‌دهم.","concept_ids":["grammar.personalpronomen.akkusativ_dativ"],"rule_ids":["ga-a1b1-ch020-r1","ga-a1b1-ch020-r2"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":50,"pdf_page":48,"locator_note":"ga-a1b1-ch020: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"}],"exceptions":[],"common_errors":[{"error_id":"ga-a1b1-ch020-ce1","wrong_example_de":"Ich helfe dich.","correct_example_de":"Ich helfe dir.","explanation_de":"helfen verlangt hier den Dativ; das Pronomen zu du lautet dir.","explanation_fa":"helfen در اینجا داتیو می‌گیرد و ضمیر du در داتیو dir است.","skill_tags":["personalpronomen","dativ"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":50,"pdf_page":48,"locator_note":"Kapitel 20 Akkusativ/Dativ-Kontrast"}],"origin_type":"GENERATED"}],"exercise_ids":["ga-a1b1-ch020-x1","ga-a1b1-ch020-x2"],"speaking_tasks":[],"linked_object_ids":[],"prerequisite_lesson_ids":[],"provenance":{"primary_source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":50,"pdf_page":48,"locator_note":"ga-a1b1-ch020: printed source page 50"},{"source_id":"grammatik-aktiv-a1-b1","printed_page":51,"pdf_page":49,"locator_note":"ga-a1b1-ch020: printed source page 51"}],"source_hash":"aeb7625f628105204590b20870a03e92648d49366d12b478412228c8078e4207","source_first":true},"qa_status":"EVIDENCE_LINKED_DRAFT"},"exercises":[{"exercise_id":"ga-a1b1-ch020-x1","lesson_id":"lesson.ga-a1b1-ch020","exercise_type":"CASE_SELECTION","prompt_de":"Ersetzen Sie das Nomen durch das passende Personalpronomen im Akkusativ oder Dativ.","answer_spec":{"mode":"pronoun_case"},"feedback_rules":["Kasus bestimmen","Pronomenform wählen"],"skill_tags":["personalpronomen","akkusativ","dativ"],"target_object_ids":["ga-a1b1-ch020-p1"],"difficulty":"A1","source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":51,"pdf_page":49,"locator_note":"Kapitel 20 Übungen"}],"origin_type":"SOURCE_ADAPTED"},{"exercise_id":"ga-a1b1-ch020-x2","lesson_id":"lesson.ga-a1b1-ch020","exercise_type":"FILL_GAP","prompt_de":"Ergänzen Sie die passende Akkusativ- oder Dativform des Personalpronomens.","answer_spec":{"mode":"pronoun_form"},"feedback_rules":["Verb-/Präpositionsrektion aus der Aufgabe beachten"],"skill_tags":["personalpronomen","kasus"],"target_object_ids":["ga-a1b1-ch020-r1","ga-a1b1-ch020-r2"],"difficulty":"A1","source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":51,"pdf_page":49,"locator_note":"Kapitel 20 Textübung"}],"origin_type":"SOURCE_ADAPTED"}],"evidence_status":{"source_pages_reviewed":[50,51],"source_pdf_pages":[48,49],"external_evidence_used":false,"source_major_rule_capture":"COMPLETE_FOR_CHAPTER_DRAFT","notes":"Rules/patterns are source-adapted; learner examples and error items are newly generated."}}