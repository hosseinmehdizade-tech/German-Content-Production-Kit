    "title_de": "Im, am, um, von ... bis, nach und vor",
    "cefr_labels": [
      "A1"
    ],
    "short_explanation_de": "Grundlegende temporale Präpositionen und Zeitangaben.",
    "explanation_de": "Das Kapitel ordnet häufige Zeitangaben: Jahre stehen ohne Präposition; im wird bei Monaten und Jahreszeiten verwendet, am bei Tagen, Tageszeiten und Datumsangaben, um bei Uhrzeiten. Weitere Präpositionen markieren Beginn, Ende, Dauer sowie Vor- und Nachzeitigkeit.",
    "explanation_fa": "این فصل زمان‌نماهای پرکاربرد را مرتب می‌کند: سال‌ها بدون حرف اضافه می‌آیند؛ im برای ماه‌ها و فصل‌ها، am برای روزها، بخش‌های روز و تاریخ‌ها، و um برای ساعت به‌کار می‌رود. حروف اضافهٔ دیگر آغاز، پایان، بازه و قبل/بعد بودن را بیان می‌کنند.",
    "learning_goals": [
      "im, am und um korrekt wählen",
      "Beginn und Ende mit ab/von/bis ausdrücken",
      "vor, nach und seit zeitlich unterscheiden",
      "Zeitspannen mit von ... bis formulieren"
    ],
    "rules": [
      {
        "rule_id": "ga-a1b1-ch030-r1",
        "statement_de": "Jahreszahlen stehen ohne Präposition; Monate und Jahreszeiten stehen typischerweise mit im.",
        "explanation_fa": "سال‌ها بدون حرف اضافه می‌آیند و ماه‌ها و فصل‌ها معمولاً با im.",
        "scope": "Jahr, Monat, Jahreszeit",
        "positive_examples": [
          "1999",
          "im Mai",
          "im Winter"
        ],
