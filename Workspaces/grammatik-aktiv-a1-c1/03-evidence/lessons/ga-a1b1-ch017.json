            "pdf_page": 42,
            "locator_note": "Kapitel 17: Dativtabelle"
          }
        ],
        "origin_type": "SOURCE_ADAPTED"
      },
      {
        "rule_id": "ga-a1b1-ch017-r2",
        "statement_de": "Im Dativ sind die maskuline und neutrale Artikelreihe gleich: dem/einem/keinem; feminin hat der/einer/keiner.",
        "explanation_fa": "در داتیو ردیف مذکر و خنثی یکسان است: dem/einem/keinem؛ مؤنث der/einer/keiner دارد.",
        "scope": "Genus im Dativ",
        "positive_examples": [
          "dem Mann",
          "dem Kind",
          "der Frau"
        ],
        "exception_ids": [],
        "source_refs": [
          {
            "source_id": "grammatik-aktiv-a1-b1",
