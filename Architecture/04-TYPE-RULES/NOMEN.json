{
  "type_rule_schema_version": "2.0.0",
  "rule_id": "nomen@2.0.1",
  "applies_to": ["nomen"],
  "core_fields": {
    "singular": {"type": "string", "required": false, "nullable": false, "min_length": 1},
    "article": {"type": "string", "required": false, "nullable": false, "enum": ["der", "die", "das"]},
    "gender": {"type": "string", "required": false, "nullable": false, "enum": ["masculine", "feminine", "neuter"]},
    "plural": {"type": "string", "required": false, "nullable": false, "min_length": 1},
    "genitive_singular": {"type": "string", "required": false, "nullable": false, "min_length": 1},
    "plural_only": {"type": "boolean", "required": true, "nullable": false}
  },
  "detail_fields": {
    "word_family": {"type": "array", "required": false, "nullable": false, "items": {"type": "string", "required": false, "nullable": false, "min_length": 1}, "min_items": 1, "unique_items": true},
    "synonyms": {"type": "array", "required": false, "nullable": false, "items": {"type": "string", "required": false, "nullable": false, "min_length": 1}, "min_items": 1, "unique_items": true},
    "antonyms": {"type": "array", "required": false, "nullable": false, "items": {"type": "string", "required": false, "nullable": false, "min_length": 1}, "min_items": 1, "unique_items": true},
    "grammar_notes": {"type": "array", "required": false, "nullable": false, "items": {"type": "string", "required": false, "nullable": false, "min_length": 1}, "min_items": 1}
  },
  "allow_undeclared_core_fields": false,
  "allow_undeclared_detail_fields": false,
  "conditional_requirements": [
    {"scope": "core", "when_field": "plural_only", "equals": false, "require_fields": ["singular"]},
    {"scope": "core", "when_field": "plural_only", "equals": true, "require_fields": ["plural"]}
  ],
  "linguistic_checks": ["Article, gender and number forms match the intended sense.", "Unavailable plural information is omitted rather than replaced by a placeholder."]
}
