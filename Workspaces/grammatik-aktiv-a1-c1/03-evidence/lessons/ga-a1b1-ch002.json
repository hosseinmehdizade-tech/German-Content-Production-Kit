    "title_de": "Ich komme, du kommst",
    "cefr_labels": [
      "A1"
    ],
    "short_explanation_de": "Regelmäßige Präsensendungen und zwei wichtige Aussprache-/Schreibanpassungen.",
    "explanation_de": "Das Kapitel führt die Personalendungen im Präsens ein. Neben dem Grundmuster zeigt es typische Anpassungen bei Stämmen auf -t/-d sowie auf Zischlaute.",
    "explanation_fa": "این فصل پایان‌های شخصی فعل در زمان حال را معرفی می‌کند و دو تغییر مهم را نشان می‌دهد: افزودن e در برخی ریشه‌های پایان‌یافته به t/d و ساده‌شدن پایان du پس از صداهای سایشی.",
    "learning_goals": [
      "regelmäßige Präsensformen bilden",
      "Endungen den Personen zuordnen",
      "Formen wie arbeitest und heißt korrekt bilden"
    ],
    "rules": [
      {
        "rule_id": "ga-a1b1-ch002-r1",
        "statement_de": "Im Präsens trägt der Verbstamm je nach Person die Endungen -e, -st, -t, -en, -t, -en.",
        "explanation_fa": "در زمان حال، به ریشهٔ فعل بر اساس شخص پایان‌های ‎-e، ‎-st، ‎-t، ‎-en، ‎-t و ‎-en اضافه می‌شوند.",
        "scope": "regelmäßige Verben im Präsens",
        "positive_examples": [
          "ich komme",
          "du kommst",
          "wir kommen"
        ],
        "exception_ids": [],
        "source_refs": [
          {
            "source_id": "grammatik-aktiv-a1-b1",
            "printed_page": 10,
            "pdf_page": 8,
            "locator_note": "Kapitel 2: Konjugation Präsens; Regel-/Konjugationstabelle auf der Kapitelauftaktseite"
          }
        ],
        "origin_type": "SOURCE_ADAPTED"
      },
      {
        "rule_id": "ga-a1b1-ch002-r2",
        "statement_de": "Bei Verbstämmen auf -t oder -d wird vor bestimmten Endungen ein zusätzliches -e- gesprochen und geschrieben.",
        "explanation_fa": "اگر ریشهٔ فعل به ‎-t یا ‎-d ختم شود، پیش از بعضی پایان‌ها یک ‎-e- اضافه می‌شود تا تلفظ ممکن شود.",
        "scope": "z. B. arbeiten, reden",
        "positive_examples": [
          "du arbeitest",
          "er arbeitet",
          "ihr arbeitet"
        ],
        "exception_ids": [],
