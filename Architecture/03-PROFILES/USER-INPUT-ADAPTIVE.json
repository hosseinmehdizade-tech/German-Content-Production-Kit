  "lexical_scope": {"allowed_pos": ["verb", "noun", "adjective", "adverb", "pronoun", "preposition", "conjunction", "particle", "interjection", "numeral", "phrase", "redemittel", "structure"], "allowed_expression_types": ["multiword_expression", "reflexive_verb", "collocation", "nvv", "idiom"], "sense_split_policy": "split_when_meaning_or_valency_or_construction_changes", "definition_de_required": true, "translations_required": ["fa", "en"]},
  "examples": {"default": {"target": 4, "minimum": 4, "maximum": 4, "enforcement": "exact"}, "translations_required": ["fa", "en"], "annotation_policy": "target_occurrences_required_when_unambiguous", "offset_model": "javascript-utf16-code-units", "diversity_required": true, "exact_target_failure_mode": "block_delivery", "documented_shortfall_allowed": false},
  "relations": {"enabled": true, "allowed_types": ["REKTION", "COLLOCATION", "RELATED", "SYNONYM", "ANTONYM", "NVV", "COMPONENT", "WORD_FAMILY"], "nvv_must_remain_separate_from_collocation": true, "evidence_required_for": ["REKTION", "COLLOCATION", "SYNONYM", "ANTONYM", "NVV", "WORD_FAMILY"], "minimum_density": "no-fabrication", "component_relations_may_be_derived_from_structure": true, "runtime_reverse_navigation_is_derived_not_canonical": true},
  "grammar": {"mode": "optional", "generation_unit": "concept-cluster-not-one-per-word", "required_fields": ["title", "cefr", "short_explanation_de", "explanation_de", "common_errors", "skill_tags", "linked_object_ids", "example_ids", "exercise_ids", "prerequisite_ids"]},
  "reading": {"mode": "optional", "generation_unit": "topic-level-batch", "translations_required": ["fa", "en"], "clickable_annotations_required": true, "comprehension_exercises_required": true},
  "exercises": {"mode": "optional", "allowed_types": ["MULTIPLE_CHOICE", "TRUE_FALSE", "FILL_GAP", "SHORT_ANSWER"], "feedback_rules_required": true, "skill_tags_required": true, "target_object_ids_required": true},
  "adaptive_metadata": {"explicit_skill_tags": true, "explicit_target_object_ids": true, "fuzzy_cross_domain_fusion_forbidden": true, "runtime_learning_state_forbidden": true},
  "source_policy": {"registry_id": "gfp-approved-language-sources@1.1.0", "user_provided_membership_source_allowed": true, "require_registered_source_for_membership": false, "require_registered_source_for_enriched_claims": true, "require_approved_source_for_enriched_claims": true, "require_verified_source_for_enriched_claims": true, "minimum_verified_sources_for_enriched_claims": 1, "stronger_evidence_for_risky_claims": true, "field_authority_matrix_id": "gfp-field-authority-matrix@1.1.0", "reference_evidence_policy": "reference-evidence@1.0.0", "minimal_source_set_required": true, "duplicate_lineage_counts_once": true, "pedagogical_or_corpus_is_not_lexical_authority": true},
  "linguistic_strictness": "strict",
