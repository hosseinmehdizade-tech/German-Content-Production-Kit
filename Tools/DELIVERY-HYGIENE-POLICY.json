{
  "policy_version": "1.1.0",
  "kit_version": "3.3.4",
  "delivery_mode": "clean-staging-required",
  "rules": {
    "build_from_previous_delivery_zip_forbidden": true,
    "staging_must_start_empty": true,
    "direct_import_tsv_required": true,
    "source_inventory_is_not_import_tsv": true,
    "canonical_json_required": true,
    "source_output_map_tsv_required": true,
    "qa_report_required": true,
    "manifest_required": true,
    "sha256_manifest_required": true,
    "nested_archives_forbidden": true,
    "runtime_state_forbidden": true,
    "cache_artifacts_forbidden": true,
    "historical_reports_not_current_evidence": true,
    "unified_vocabulary_card_type_column_required": true,
    "unified_vocabulary_category_column_required": true,
    "unified_vocabulary_neutral_card_type": "de-vocabulary",
    "legacy_german_verb_new_delivery_forbidden": true,
    "builder_must_invoke_projection_validator": true,
    "builder_must_fail_before_zip_on_projection_violation": true
  }
}
