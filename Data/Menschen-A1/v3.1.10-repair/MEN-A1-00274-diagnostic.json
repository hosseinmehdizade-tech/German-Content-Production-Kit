  "examples": [
    {
      "id": "MEN-A1-00274-ex-001",
      "lang": "de-DE",
      "text": "Ich bewerbe mich um eine Stelle als Ingenieur.",
      "order": 1,
      "translations": [
        {
          "lang": "fa-IR",
          "text": "برای شغل مهندسی درخواست می‌دهم."
        },
        {
          "lang": "en-US",
          "text": "I am applying for a job as an engineer."
        }
      ]
    },
    {
      "id": "MEN-A1-00274-ex-002",
      "lang": "de-DE",
      "text": "Sie hat sich um die freie Stelle beworben.",
      "order": 2,
      "translations": [
        {
          "lang": "fa-IR",
          "text": "او برای جای خالی درخواست داد."
        },
        {
          "lang": "en-US",
          "text": "She applied for the vacant position."
        }
      ]
    },
    {
      "id": "MEN-A1-00274-ex-003",
      "lang": "de-DE",
      "text": "Viele Menschen bewerben sich um diese Stelle.",
      "order": 3,
      "translations": [
        {
          "lang": "fa-IR",
          "text": "افراد زیادی برای این شغل درخواست می‌دهند."
        },
        {
          "lang": "en-US",
          "text": "Many people apply for this job."
        }
      ]
    },
    {
      "id": "MEN-A1-00274-ex-004",
      "lang": "de-DE",
      "text": "Bewirbst du dich um eine Vollzeitstelle?",
      "order": 4,
      "translations": [
        {
          "lang": "fa-IR",
          "text": "برای شغل تمام‌وقت درخواست می‌دهی؟"
        },
        {
          "lang": "en-US",
          "text": "Are you applying for a full-time position?"
        }
      ]
    }
