{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gfp.local/schemas/source-registry-v1.schema.json",
  "title": "GFP Approved Language Source Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_schema_version",
    "registry_id",
    "sources"
  ],
  "properties": {
    "registry_schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "const": "gfp-approved-language-sources@1.1.0"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "provider",
        "kind",
        "approval_status",
        "authority_level",
        "independence_group",
        "base_url",
        "language_pairs",
        "roles",
        "allowed_claims"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "book",
            "course",
            "lexicon",
            "corpus",
            "website",
            "expert",
            "generated",
            "other"
          ]
        },
        "approval_status": {
          "enum": [
            "approved",
            "test_only",
            "deprecated"
          ]
        },
        "authority_level": {
          "enum": [
            "primary",
            "secondary",
            "reference",
            "test"
          ]
        },
        "independence_group": {
          "type": "string",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "language_pairs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(?:-[A-Z]{2})?->[a-z]{2}(?:-[A-Z]{2})?$"
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "german_monolingual",
              "german_grammar_authority",
              "german_english_bilingual",
              "german_persian_bilingual",
              "english_learner_reference",
              "corpus_evidence",
              "test_fixture"
            ]
          }
        },
        "allowed_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "architecture_fixture",
              "german_sense",
              "german_definition",
              "orthography",
              "grammar",
              "rection",
              "morphology",
              "usage",
              "register",
              "collocation",
              "synonymy",
              "antonymy",
              "word_family",
              "frequency",
              "corpus_usage",
              "etymology",
              "bilingual_sense_match",
              "persian_gloss",
              "persian_wording",
              "persian_example_translation",
              "english_gloss",
              "english_wording",
              "english_example_translation",
              "example_attestation"
            ]
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
