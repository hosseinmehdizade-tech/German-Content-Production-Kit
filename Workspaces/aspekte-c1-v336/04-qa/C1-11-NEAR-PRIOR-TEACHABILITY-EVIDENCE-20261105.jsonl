{"card_approved": false, "chapter": 6, "decision_authority": "B1B2_SANITIZED_AND_DICTIONARY_SCOPED_ONLY", "exclude_from_c1_import_now": false, "external_evidence_urls": ["https://www.duden.de/rechtschreibung/Hausmittel"], "global_dedup_decision": "PENDING_ORIGINAL_SOURCE_AND_FULL_SEMANTIC_GATE", "headword": "Hausmittel", "id": "C1-P21-E082", "independent_menschen_9109_verified": false, "independent_original_b1b2_3275_verified": false, "prior_exact_token_matches_in_3274_sanitized_rows": [], "prior_nearest_witnesses": [{"component_hint": "mittel", "prior_definition_fa": "وسیله، طریقه، ماده، دارو، وجوه، میانگین", "prior_example": "", "prior_headword": "das Mittel, -", "prior_level_tag": "Aspekte_B1+/B2::06_B1+:_3_–_Wie_geht's_denn_so?_2", "source_csv_ordinal": 315}], "publisher_alphabetical_witness_only": false, "reason_de": "Hausmittel steht für im privaten Gebrauch bewährte Behandlungsmittel. B1 Mittel in der Bedeutung Arznei erklärt noch nicht die spezifische traditionelle oder häusliche Anwendung.", "reason_fa": "درمان خانگی امتحان‌شده؛ «Mittel» عمومی این معنای تخصصی را به‌تنهایی نمی‌رساند.", "scoped_decision": "RETAIN_DISTINCT_SENSE_CANDIDATE", "source_index_raw_verified": true, "source_pdf_sha256": "b05c90320ad75dc19be12a374087830bd2c379206a5711e604a6aea699e189cf", "source_raw": "das Hausmittel, -"}
{"card_approved": false, "chapter": 6, "decision_authority": "B1B2_SANITIZED_AND_DICTIONARY_SCOPED_ONLY", "exclude_from_c1_import_now": false, "external_evidence_urls": ["https://www.duden.de/rechtschreibung/Nebenwirkung"], "global_dedup_decision": "PENDING_ORIGINAL_SOURCE_AND_FULL_SEMANTIC_GATE", "headword": "Nebenwirkung", "id": "C1-P21-E087", "independent_menschen_9109_verified": false, "independent_original_b1b2_3275_verified": false, "prior_exact_token_matches_in_3274_sanitized_rows": [], "prior_nearest_witnesses": [{"component_hint": "wirkung", "prior_definition_fa": "تاثیر، اثر، معمول، نتیجه", "prior_example": "", "prior_headword": "die Wirkung, -en", "prior_level_tag": "Aspekte_B1+/B2::06_B1+:_3_–_Wie_geht's_denn_so?_2", "source_csv_ordinal": 294}], "publisher_alphabetical_witness_only": false, "reason_de": "Eine Nebenwirkung ist eine zusätzliche, oft unerwünschte Wirkung; Wirkung kann sehr viel allgemeiner sein. Der Spezialbegriff rechtfertigt einen eigenständigen Kandidaten.", "reason_fa": "عارضه یا اثر جانبی؛ جزء «Wirkung» به‌تنهایی کافی نیست.", "scoped_decision": "RETAIN_DISTINCT_SENSE_CANDIDATE", "source_index_raw_verified": true, "source_pdf_sha256": "b05c90320ad75dc19be12a374087830bd2c379206a5711e604a6aea699e189cf", "source_raw": "die Nebenwirkung, -en"}
{"card_approved": false, "chapter": 8, "decision_authority": "B1B2_SANITIZED_AND_DICTIONARY_SCOPED_ONLY", "exclude_from_c1_import_now": false, "external_evidence_urls": ["https://www.duden.de/rechtschreibung/Gesamtauflage"], "global_dedup_decision": "PENDING_ORIGINAL_SOURCE_AND_FULL_SEMANTIC_GATE", "headword": "Gesamtauflage", "id": "C1-P31-E048", "independent_menschen_9109_verified": false, "independent_original_b1b2_3275_verified": false, "prior_exact_token_matches_in_3274_sanitized_rows": [], "prior_nearest_witnesses": [{"component_hint": "gesamt", "prior_definition_fa": "کلیه، تمام، همه", "prior_example": "", "prior_headword": "gesamt", "prior_level_tag": "Aspekte_B1+/B2::28_B2:_5_–_Wer_Wissen_schafft,_macht_Wissenschaft", "source_csv_ordinal": 2284}], "publisher_alphabetical_witness_only": false, "reason_de": "Quellengloss präzisiert: Duden nennt die Gesamtheit der Auflagen eines Buches. Frühere Formulierung „gesamte Zahl der gedruckten Exemplare“ war zu eng/ungenau. B2 gesamt ist lediglich ein Adjektiv.", "reason_fa": "مجموع نوبت‌های چاپ یک کتاب؛ نه صرفاً مجموع نسخه‌های چاپ‌شده.", "scoped_decision": "RETAIN_DISTINCT_SENSE_CANDIDATE", "source_index_raw_verified": true, "source_pdf_sha256": "b05c90320ad75dc19be12a374087830bd2c379206a5711e604a6aea699e189cf", "source_raw": "die Gesamtauflage, -n"}
