age","columns":["Position 1","Position 2","Position 3 / Rest"],"rows":[["Wo","wohnst","du?"],["Wann","kommt","er?"],["Mit wem","spricht","sie?"],["Warum","lernst","du Deutsch?"]],"notes_de":[],"notes_fa":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":26,"pdf_page":24,"locator_note":"Kapitel 9: Fragetabelle"}]}],"examples":[{"example_id":"ga-a1b1-ch009-e1","text_de":"Wo arbeitest du?","translation_fa":"کجا کار می‌کنی؟","concept_ids":["grammar.fragen.w_fragen"],"rule_ids":["ga-a1b1-ch009-r1","ga-a1b1-ch009-r2"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":26,"pdf_page":24,"locator_note":"ga-a1b1-ch009: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch009-e2","text_de":"Wann beginnt der Kurs?","translation_fa":"کلاس چه زمانی شروع می‌شود؟","concept_ids":["grammar.fragen.w_fragen"],"rule_ids":["ga-a1b1-ch009-r1","ga-a1b1-ch009-r2"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":26,"pdf_page":24,"locator_note":"ga-a1b1-ch009: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch009-e3","text_de":"Mit wem gehst du ins Kino?","translation_fa":"با چه کسی به سینما می‌روی؟","concept_ids":["grammar.fragen.w_fragen"],"rule_ids":["ga-a1b1-ch009-r1","ga-a1b1-ch009-r2"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":26,"pdf_page":24,"locator_note":"ga-a1b1-ch009: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch009-e4","text_de":"Warum lernst du Deutsch?","translation_fa":"چرا آلمانی یاد می‌گیری؟","concept_ids":["grammar.fragen.w_fragen"],"rule_ids":["ga-a1b1-ch009-r1","ga-a1b1-ch009-r2"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":26,"pdf_page":24,"locator_note":"ga-a1b1-ch009: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"}],"exce