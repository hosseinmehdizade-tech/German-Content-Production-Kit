    ],
    "short_explanation_de": "für, um, durch, ohne und gegen stehen mit Akkusativ.",
    "explanation_de": "Das Kapitel fasst fünf häufige Akkusativpräpositionen zusammen. Die Quelle nutzt die Merkhilfe FUDOG und zeigt typische Bedeutungen wie Durchgang, Bewegung um etwas, Kontakt/Richtung gegen etwas, Fehlen sowie Bestimmung für eine Person.",
    "explanation_fa": "این فصل پنج حرف اضافهٔ پرکاربرد را که Akkusativ می‌گیرند جمع‌بندی می‌کند. منبع از یادآور FUDOG استفاده می‌کند و کاربردهایی مانند عبور از چیزی، حرکت دور چیزی، برخورد/جهت به سوی چیزی، نبودن چیزی و «برای» یک شخص را نشان می‌دهد.",
    "learning_goals": [
      "für, um, durch, ohne und gegen mit Akkusativ verwenden",
      "die fünf Präpositionen semantisch unterscheiden",
      "ohne in typischen Konstruktionen korrekt verwenden"
    ],
    "rules": [
      {
        "rule_id": "ga-a1b1-ch032-r1",
        "statement_de": "für, um, durch, ohne und gegen stehen immer mit Akkusativ.",
        "explanation_fa": "für، um، durch، ohne و gegen همیشه Akkusativ می‌گیرند.",
        "scope": "Kasusrektion",
        "positive_examples": [
          "durch das Fenster",
          "um den Tisch",
          "gegen den Tisch",
          "für dich"
        ],
        "exception_ids": [],
