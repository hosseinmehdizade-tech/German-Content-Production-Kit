    ],
    "short_explanation_de": "Trennbare Verben: Präfix, Satzklammer und ungetrennter Infinitiv.",
    "explanation_de": "Das Kapitel zeigt, wie trennbare Verben im Hauptsatz getrennt werden und wann sie als ungetrennter Infinitiv zusammenbleiben.",
    "explanation_fa": "این فصل نشان می‌دهد فعل‌های جداشدنی در جملهٔ اصلی چگونه جدا می‌شوند و چه زمانی به‌صورت مصدرِ یکپارچه باقی می‌مانند.",
    "learning_goals": [
      "trennbare Verben im Hauptsatz bilden",
      "Infinitiv mit Modalverb korrekt verwenden",
      "trennbare Verben im Nebensatz erkennen"
    ],
    "rules": [
      {
        "rule_id": "ga-a1b1-ch007-r1",
        "statement_de": "Bei einem trennbaren Verb steht im Hauptsatz das konjugierte Verb auf Position 2 und das Präfix am Satzende.",
        "explanation_fa": "در جملهٔ اصلی، بخش صرف‌شدهٔ فعل در جایگاه دوم و پیشوند جداشدنی در پایان جمله قرار می‌گیرد.",
        "scope": "Hauptsatz",
        "positive_examples": [
          "Ich kaufe heute ein.",
          "Er steht früh auf.",
          "Wir kommen morgen zurück."
        ],
        "exception_ids": [],
        "source_refs": [
          {
            "source_id": "grammatik-aktiv-a1-b1",
            "printed_page": 20,
            "pdf_page": 18,
            "locator_note": "Kapitel 7: trennbares Verb im Hauptsatz"
          }
        ],
        "origin_type": "SOURCE_ADAPTED"
      },
      {
        "rule_id": "ga-a1b1-ch007-r2",
        "statement_de": "Nach einem Modalverb bleibt der Infinitiv des trennbaren Verbs zusammen und steht am Satzende.",
        "explanation_fa": "پس از فعل مدال، مصدرِ فعل جداشدنی یکپارچه می‌ماند و در پایان جمله می‌آید.",
        "scope": "Modalverb + trennbarer Infinitiv",
        "positive_examples": [
          "Ich muss morgen einkaufen.",
          "Wir wollen früh aufstehen.",
          "Sie kann später zurückkommen."
        ],
        "exception_ids": [],
        "source_refs": [
          {
            "source_id": "grammatik-aktiv-a1-b1",
            "printed_page": 20,
            "pdf_page": 18,
