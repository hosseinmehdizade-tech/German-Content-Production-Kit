          }
        ],
        "origin_type": "SOURCE_ADAPTED"
      },
      {
        "rule_id": "ga-a1b1-ch027-r3",
        "statement_de": "Für einen Wunsch, der in der Gegenwart mit möchten ausgedrückt wird, verwendet die Quelle in der Vergangenheit wollte; möchten hat kein eigenes Präteritumparadigma.",
        "explanation_fa": "برای خواسته‌ای که در زمان حال با möchten بیان می‌شود، منبع در گذشته از wollte استفاده می‌کند؛ möchten صرفِ مستقلِ Präteritum ندارد.",
        "scope": "möchten im Zeitkontrast",
        "positive_examples": [
          "Heute möchte ich einen Wein.",
          "Gestern wollte ich ein Bier."
        ],
