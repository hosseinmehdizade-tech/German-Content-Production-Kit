{"source_chapter_id":"ga-a1b1-ch001","source_book_id":"grammatik-aktiv-a1-b1","source_hash":"aeb7625f628105204590b20870a03e92648d49366d12b478412228c8078e4207","status":"EVIDENCE_LINKED_DRAFT","lesson":{"lesson_id":"lesson.ga-a1b1-ch001","source_chapter_id":"ga-a1b1-ch001","concept_ids":["grammar.personalpronomen.nominativ"],"title_de":"Ich, du, er, sie, es, wir, ihr, sie und Sie","cefr_labels":["A1"],"short_explanation_de":"Personalpronomen für Personen und Sachen.","explanation_de":"Das Kapitel führt die grundlegenden Personalpronomen ein und zeigt auch, wie Nomen für Sachen durch er, es oder sie ersetzt werden.","explanation_fa":"این فصل ضمیرهای شخصی پایه را معرفی می‌کند و نشان می‌دهد اسمِ اشیا با er، es یا sie جایگزین می‌شود.","learning_goals":["Personalpronomen nach Person und Numerus wählen","Nomen für Sachen mit dem richtigen Pronomen ersetzen"],"rules":[{"rule_id":"ga-a1b1-ch001-r1","statement_de":"Personalpronomen ersetzen Personen und zeigen Person und Numerus: ich/wir, du/ihr, er/sie/es sowie sie/Sie.","explanation_fa":"ضمیرهای شخصی جای اسم افراد می‌آیند و شخص و شمار را نشان می‌دهند: ich/wir، du/ihr، er/sie/es و sie/Sie.","scope":"Personalpronomen für Personen","positive_examples":["Ich lerne Deutsch.","Wir wohnen in Essen.","Sie kommt morgen."],"exception_ids":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":8,"pdf_page":6,"locator_note":"ga-a1b1-ch001: Personalpronomen für Personen"}],"origin_type":"SOURCE_ADAPTED"},{"rule_id":"ga-a1b1-ch001-r2","statement_de":"Bei Sachen richtet sich das Personalpronomen nach dem Genus beziehungsweise Numerus des Nomens: der → er, das → es, die → sie; Plural die → sie.","explanation_fa":"برای اشیا، ضمیر شخصی از جنس و شمار اسم پیروی می‌کند: der → er، das → es، die → sie و جمع die → sie.","scope":"Pronomen für Sachen","positive_examples":["Der Löffel ist neu. Er liegt hier.","Das Messer ist scharf. Es liegt dort.","Die Tasse ist sauber. Sie steht im Schrank."],"exception_ids":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":8,"pdf_page":6,"locator_note":"ga-a1b1-ch001: Pronomen für Sachen"}],"origin_type":"SOURCE_ADAPTED"}],"patterns":[{"pattern_id":"ga-a1b1-ch001-p1","pattern_type":"COMPARISON","title_de":"Personalpronomen nach Person und Numerus","columns":["Person","Singular","Plural"],"rows":[["1.","ich","wir"],["2.","du","ihr"],["3.","er/sie/es","sie"],["Höflichkeitsform","Sie","Sie"]],"notes_de":[],"notes_fa":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":8,"pdf_page":6,"locator_note":"Kapitel 1: Pronomen für Personen"}]}],"examples":[{"example_id":"ga-a1b1-ch001-e1","text_de":"Ich komme aus dem Iran.","translation_fa":"من اهل ایران هستم.","concept_ids":["grammar.personalpronomen.nominativ"],"rule_ids":["ga-a1b1-ch001-r1"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":8,"pdf_page":6,"locator_note":"ga-a1b1-ch001: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch001-e2","text_de":"Wir lernen heute zusammen.","translation_fa":"امروز با هم یاد می‌گیریم.","concept_ids":["grammar.personalpronomen.nominativ"],"rule_ids":["ga-a1b1-ch001-r1"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":8,"pdf_page":6,"locator_note":"ga-a1b1-ch001: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch001-e3","text_de":"Der Computer ist neu. Er ist sehr schnell.","translation_fa":"کامپیوتر جدید است. خیلی سریع است.","concept_ids":["grammar.personalpronomen.nominativ"],"rule_ids":["ga-a1b1-ch001-r2"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":8,"pdf_page":6,"locator_note":"ga-a1b1-ch001: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch001-e4","text_de":"Die Bücher sind hier. Sie gehören mir.","translation_fa":"کتاب‌ها اینجا هستند. مال من‌اند.","concept_ids":["grammar.personalpronomen.nominativ"],"rule_ids":["ga-a1b1-ch001-r2"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":8,"pdf_page":6,"locator_note":"ga-a1b1-ch001: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"}],"exceptions":[],"common_errors":[{"error_id":"ga-a1b1-ch001-ce1","wrong_example_de":"Das Buch ist neu. Sie ist teuer.","correct_example_de":"Das Buch ist neu. Es ist teuer.","explanation_de":"Buch ist Neutrum; deshalb steht es.","explanation_fa":"Buch خنثی است؛ بنابراین ضمیر es می‌آید.","skill_tags":["pronomen","genus"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":8,"pdf_page":6,"locator_note":"ga-a1b1-ch001: relevant source rule"}],"origin_type":"GENERATED"}],"exercise_ids":["ga-a1b1-ch001-x1","ga-a1b1-ch001-x2"],"speaking_tasks":[],"linked_object_ids":[],"prerequisite_lesson_ids":[],"provenance":{"primary_source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":8,"pdf_page":6,"locator_note":"ga-a1b1-ch001: printed source page 8"},{"source_id":"grammatik-aktiv-a1-b1","printed_page":9,"pdf_page":7,"locator_note":"ga-a1b1-ch001: printed source page 9"}],"source_hash":"aeb7625f628105204590b20870a03e92648d49366d12b478412228c8078e4207","source_first":true},"qa_status":"EVIDENCE_LINKED_DRAFT"},"exercises":[{"exercise_id":"ga-a1b1-ch001-x1","lesson_id":"lesson.ga-a1b1-ch001","exercise_type":"FILL_GAP","prompt_de":"Ersetzen Sie das Nomen durch das passende Personalpronomen.","answer_spec":{"mode":"single_pronoun"},"feedback_rules":["Person/Genus/Numerus prüfen"],"skill_tags":["personalpronomen"],"target_object_ids":["ga-a1b1-ch001-p1"],"difficulty":"A1","source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":8,"pdf_page":6,"locator_note":"Kapitel 1 Übungen zu Personalpronomen"}],"origin_type":"SOURCE_ADAPTED"},{"exercise_id":"ga-a1b1-ch001-x2","lesson_id":"lesson.ga-a1b1-ch001","exercise_type":"SHORT_ANSWER","prompt_de":"Nennen Sie das passende Pronomen zu einem Nomen.","answer_spec":{"mode":"short_text"},"feedback_rules":["Genus/Numerus prüfen"],"skill_tags":["personalpronomen","genus"],"target_object_ids":["ga-a1b1-ch001-r2"],"difficulty":"A1","source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":8,"pdf_page":6,"locator_note":"Kapitel 1 Pronomen für Sachen"}],"origin_type":"SOURCE_ADAPTED"}],"evidence_status":{"source_pages_reviewed":[8,9],"source_pdf_pages":[6,7],"external_evidence_used":false,"source_major_rule_capture":"COMPLETE_FOR_CHAPTER_DRAFT","notes":"Rules/patterns are source-adapted; learner examples and error items are newly generated."}}