    "title_de": "Im Kino oder ins Kino?",
    "cefr_labels": [
      "A2"
    ],
    "short_explanation_de": "Wechselpräpositionen unterscheiden Ort (Wo? + Dativ) und Richtung (Wohin? + Akkusativ).",
    "explanation_de": "Das Kapitel stellt die neun Wechselpräpositionen als Kontrast zwischen statischer Ortsangabe und gerichteter Bewegung dar und übt die dazugehörigen Artikelformen.",
    "explanation_fa": "این فصل نه حرف اضافهٔ دوحالته را بر اساس تفاوت «مکان ثابت» و «جهت/مقصد» آموزش می‌دهد: Wo? با Dativ و Wohin? با Akkusativ.",
    "learning_goals": [
      "Wo? und Wohin? unterscheiden",
      "bei Wechselpräpositionen Dativ oder Akkusativ wählen",
      "häufige Verschmelzungen korrekt verwenden"
    ],
    "rules": [
      {
        "rule_id": "ga-a1b1-ch034-r1",
        "statement_de": "Die Wechselpräpositionen in, an, auf, über, unter, vor, hinter, neben und zwischen stehen bei einer Richtung auf die Frage „Wohin?“ mit Akkusativ.",
        "explanation_fa": "حروف اضافهٔ دوحالتهٔ in, an, auf, über, unter, vor, hinter, neben و zwischen وقتی جهت یا مقصد را بیان می‌کنند و پاسخِ «Wohin?» هستند، با Akkusativ می‌آیند.",
        "scope": "Richtung / direktiv",
        "positive_examples": [
          "in die Tasche",
          "an den Baum",
          "auf den Boden"
        ],
        "exception_ids": [],
