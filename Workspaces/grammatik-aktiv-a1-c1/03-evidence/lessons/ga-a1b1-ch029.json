    "title_de": "Sie wäscht sich",
    "cefr_labels": [
      "A2"
    ],
    "short_explanation_de": "Reflexive und reziproke Verben mit sich.",
    "explanation_de": "Das Kapitel führt Reflexivpronomen ein, zeigt ihre Formen und Position im Satz und unterscheidet reflexive von reziproken Verwendungen. Außerdem wird das Perfekt reflexiver Verben mit haben gezeigt.",
    "explanation_fa": "این فصل ضمیرهای بازتابی را معرفی می‌کند، شکل‌ها و جایگاه آن‌ها در جمله را نشان می‌دهد و کاربرد بازتابی را از متقابل جدا می‌کند. همچنین Perfekt فعل‌های بازتابی با haben نشان داده می‌شود.",
    "learning_goals": [
      "Reflexivpronomen im Akkusativ bilden",
      "Reflexivpronomen richtig positionieren",
      "reflexive und reziproke Bedeutung unterscheiden",
      "Perfekt reflexiver Verben mit haben bilden"
    ],
    "rules": [
      {
        "rule_id": "ga-a1b1-ch029-r1",
        "statement_de": "Die Reflexivpronomen im Akkusativ lauten mich, dich, sich, uns, euch, sich; nur die 3. Person hat die besondere Form sich.",
        "explanation_fa": "ضمیرهای بازتابی در Akkusativ عبارت‌اند از mich، dich، sich، uns، euch، sich؛ فقط سوم‌شخص شکل ویژهٔ sich دارد.",
        "scope": "Reflexivpronomen",
        "positive_examples": [
          "Ich wasche mich.",
          "Du wäschst dich.",
          "Sie wäscht sich."
        ],
        "exception_ids": [],
        "source_refs": [
          {
            "source_id": "grammatik-aktiv-a1-b1",
            "printed_page": 70,
            "pdf_page": 68,
            "locator_note": "Kapitel 29 Reflexivpronomen-Tabelle"
          }
        ],
        "origin_type": "SOURCE_ADAPTED"
      },
      {
        "rule_id": "ga-a1b1-ch029-r2",
        "statement_de": "Bei obligatorisch reflexiven Verben wie sich interessieren, sich ärgern, sich freuen oder sich langweilen gehört das Reflexivpronomen zum Verbgebrauch.",
        "explanation_fa": "در فعل‌های الزاماً بازتابی مانند sich interessieren، sich ärgern، sich freuen و sich langweilen، ضمیر بازتابی بخشی از کاربرد فعل است.",
        "scope": "obligatorisch reflexive Verben",
        "positive_examples": [
          "Ich interessiere mich für Musik.",
          "Wir freuen uns."
        ],
        "exception_ids": [],
        "source_refs": [
          {
            "source_id": "grammatik-aktiv-a1-b1",
            "printed_page": 70,
            "pdf_page": 68,
            "locator_note": "Kapitel 29 Liste reflexiver Verben"
          }
        ],
        "origin_type": "SOURCE_ADAPTED"
      },
      {
        "rule_id": "ga-a1b1-ch029-r3",
        "statement_de": "Im Hauptsatz steht das Reflexivpronomen nach Verb und Subjekt; im Nebensatz bleibt es beim Subjekt.",
        "explanation_fa": "در جملهٔ اصلی، ضمیر بازتابی پس از فعل و فاعل می‌آید؛ در جملهٔ وابسته کنار فاعل باقی می‌ماند.",
        "scope": "Wortstellung",
        "positive_examples": [
          "Er wäscht sich heute.",
          "Er kommt nicht, weil er sich heute geärgert hat."
        ],
        "exception_ids": [],
