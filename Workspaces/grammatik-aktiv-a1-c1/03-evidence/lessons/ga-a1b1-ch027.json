      },
      {
        "rule_id": "ga-a1b1-ch027-r2",
        "statement_de": "Im Präteritum haben diese Modalverben keinen Umlaut.",
        "explanation_fa": "این فعل‌های مدال در Präteritum بدون Umlaut می‌آیند.",
        "scope": "Formkontrast Präsens/Präteritum",
        "positive_examples": [
          "kann → konnte",
          "muss → musste",
          "darf → durfte"
        ],
        "exception_ids": [],
        "source_refs": [
          {
