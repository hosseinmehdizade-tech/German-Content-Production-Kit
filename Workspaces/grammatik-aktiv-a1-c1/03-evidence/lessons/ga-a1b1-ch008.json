    "short_explanation_de": "Imperativformen für du, ihr und Sie.",
    "explanation_de": "Das Kapitel zeigt die Imperativbildung für informelle und formelle Anrede sowie wichtige Formen von sein, haben und trennbaren Verben.",
    "explanation_fa": "این فصل ساخت امر برای du، ihr و Sie و نیز شکل‌های مهم sein، haben و فعل‌های جداشدنی را نشان می‌دهد.",
    "learning_goals": [
      "Imperativ für du, ihr und Sie bilden",
      "unregelmäßige und trennbare Imperativformen verwenden",
      "bitte, mal und doch passend einsetzen"
    ],
    "rules": [
      {
        "rule_id": "ga-a1b1-ch008-r1",
        "statement_de": "Beim Imperativ mit du und ihr steht das Personalpronomen nicht; bei der Höflichkeitsform steht Verb + Sie.",
        "explanation_fa": "در امر با du و ihr ضمیر شخصی نمی‌آید؛ در فرم رسمی ساخت Verb + Sie به‌کار می‌رود.",
        "scope": "Anredeformen",
        "positive_examples": [
          "Komm!",
          "Kommt!",
          "Kommen Sie!"
        ],
