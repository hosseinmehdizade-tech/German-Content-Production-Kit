{"card_approved": false, "chapter": 1, "decision_authority": "B1B2_SANITIZED_AND_DICTIONARY_SCOPED_ONLY", "exclude_from_c1_import_now": false, "external_evidence_urls": ["https://www.duden.de/deklination/substantive/Arzneimittel"], "global_dedup_decision": "PENDING_ORIGINAL_SOURCE_AND_FULL_SEMANTIC_GATE", "headword": "Arzneimittel", "id": "C1-P04-E064", "independent_menschen_9109_verified": false, "independent_original_b1b2_3275_verified": false, "prior_exact_token_matches_in_3274_sanitized_rows": [], "prior_nearest_witnesses": [{"component_hint": "mittel", "prior_definition_fa": "وسیله، طریقه، ماده، دارو، وجوه، میانگین", "prior_example": "", "prior_headword": "das Mittel, -", "prior_level_tag": "Aspekte_B1+/B2::06_B1+:_3_–_Wie_geht's_denn_so?_2", "source_csv_ordinal": 315}], "publisher_alphabetical_witness_only": false, "reason_de": "Arzneimittel bezeichnet eindeutig ein Medikament; das untere Mittel besitzt weitere, viel breitere Bedeutungen. Semantisch spezifisch; kein bloßer Teile-Treffer als Ausschlussgrund.", "reason_fa": "دارو؛ اصطلاح مشخص‌تر از «Mittel» به معنای کلی وسیله/ماده.", "scoped_decision": "RETAIN_DISTINCT_SENSE_CANDIDATE", "source_index_raw_verified": true, "source_pdf_sha256": "b05c90320ad75dc19be12a374087830bd2c379206a5711e604a6aea699e189cf", "source_raw": "das Arzneimittel, -"}
{"card_approved": false, "chapter": 2, "decision_authority": "B1B2_SANITIZED_AND_DICTIONARY_SCOPED_ONLY", "exclude_from_c1_import_now": true, "external_evidence_urls": ["https://www.duden.de/rechtschreibung/Koerperhaltung", "https://www.duden.de/rechtschreibung/Haltung"], "global_dedup_decision": "PENDING_ORIGINAL_SOURCE_AND_FULL_SEMANTIC_GATE", "headword": "Körperhaltung", "id": "C1-P06-E036", "independent_menschen_9109_verified": false, "independent_original_b1b2_3275_verified": false, "prior_exact_token_matches_in_3274_sanitized_rows": [], "prior_nearest_witnesses": [{"component_hint": "haltung", "prior_definition_fa": "حالت، وضعیت، موضع، رفتار، متانت", "prior_example": "", "prior_headword": "die Haltung, -en", "prior_level_tag": "Aspekte_B1+/B2::32_B2:_7_–_Kulturwelten_2", "source_csv_ordinal": 2723}], "publisher_alphabetical_witness_only": false, "reason_de": "Duden setzt Körperhaltung ausdrücklich mit Haltung im körperlichen Sinn gleich. Da die B2-Definition Haltung bereits حالت/وضعیت enthält, getrennte C1-Karte nur bei zusätzlicher Quellennutzung.", "reason_fa": "حالت بدن؛ قبلاً در یکی از معانی «Haltung» پوشش داده شده است.", "scoped_decision": "PROVISIONAL_MERGE_LOWER_SENSE", "source_index_raw_verified": true, "source_pdf_sha256": "b05c90320ad75dc19be12a374087830bd2c379206a5711e604a6aea699e189cf", "source_raw": "die Körperhaltung, -en"}
{"card_approved": false, "chapter": 3, "decision_authority": "B1B2_SANITIZED_AND_DICTIONARY_SCOPED_ONLY", "exclude_from_c1_import_now": true, "external_evidence_urls": ["https://www.duden.de/rechtschreibung/Berufslaufbahn", "https://www.duden.de/rechtschreibung/Laufbahn"], "global_dedup_decision": "PENDING_ORIGINAL_SOURCE_AND_FULL_SEMANTIC_GATE", "headword": "Berufslaufbahn", "id": "C1-P10-E012", "independent_menschen_9109_verified": false, "independent_original_b1b2_3275_verified": false, "prior_exact_token_matches_in_3274_sanitized_rows": [], "prior_nearest_witnesses": [{"component_hint": "laufbahn", "prior_definition_fa": "پیشرفت شغلی/کاری، پیست دومیدانی", "prior_example": "", "prior_headword": "die Laufbahn, -en", "prior_level_tag": "Aspekte_B1+/B2::34_B2:_8_–_Das_macht(e)_Geschichte_2", "source_csv_ordinal": 2938}], "publisher_alphabetical_witness_only": false, "reason_de": "Duden definiert Berufslaufbahn als berufliche Laufbahn; B2 gibt Laufbahn schon als beruflichen Werdegang. Kein unabhängiger neuer Sinn derzeit erkennbar.", "reason_fa": "مسیر شغلی؛ به لحاظ معنا با «Laufbahn» شغلی بسیار نزدیک است.", "scoped_decision": "PROVISIONAL_MERGE_LOWER_SENSE", "source_index_raw_verified": true, "source_pdf_sha256": "b05c90320ad75dc19be12a374087830bd2c379206a5711e604a6aea699e189cf", "source_raw": "die Berufslaufbahn, -en"}
{"card_approved": false, "chapter": 3, "decision_authority": "B1B2_SANITIZED_AND_DICTIONARY_SCOPED_ONLY", "exclude_from_c1_import_now": false, "external_evidence_urls": [], "global_dedup_decision": "PENDING_ORIGINAL_SOURCE_AND_FULL_SEMANTIC_GATE", "headword": "Heimatland", "id": "C1-P10-E076", "independent_menschen_9109_verified": false, "independent_original_b1b2_3275_verified": false, "prior_exact_token_matches_in_3274_sanitized_rows": [], "prior_nearest_witnesses": [{"component_hint": "heimat", "prior_definition_fa": "وطن، میهن، کشور، سرزمین، زادگاه", "prior_example": "das Zuhause", "prior_headword": "die Heimat, -en / die Heimatstadt", "prior_level_tag": "Aspekte_B1+/B2::01_B1+:_1_–_Leute_heute", "source_csv_ordinal": 2}], "publisher_alphabetical_witness_only": false, "reason_de": "Heimatland spezifiziert das Land, während Heimat sowohl Herkunftsort als auch Ort des Zugehörigkeitsgefühls meint. B1 hat das Wort Heimat mit Land als Gloss bereits abgedeckt; erst Unterrichtskontext entscheidet über Zusatznutzen.", "reason_fa": "کشور وطن؛ از «Heimat» خاص‌تر است، اما ممکن است توضیح ترکیبی کافی باشد.", "scoped_decision": "HOLD_TEACHABILITY_SENSE_OVERLAP", "source_index_raw_verified": true, "source_pdf_sha256": "b05c90320ad75dc19be12a374087830bd2c379206a5711e604a6aea699e189cf", "source_raw": "das Heimatland (Sg.)"}
{"card_approved": false, "chapter": 3, "decision_authority": "B1B2_SANITIZED_AND_DICTIONARY_SCOPED_ONLY", "exclude_from_c1_import_now": true, "external_evidence_urls": ["https://www.duden.de/rechtschreibung/Au_pair_Au_pair_Maedchen", "https://www.duden.de/rechtschreibung/Au_pair_Maedchen"], "global_dedup_decision": "PENDING_ORIGINAL_SOURCE_AND_FULL_SEMANTIC_GATE", "headword": "Au-pair-Mädchen", "id": "C1-P11-E017", "independent_menschen_9109_verified": false, "independent_original_b1b2_3275_verified": false, "prior_exact_token_matches_in_3274_sanitized_rows": [], "prior_nearest_witnesses": [{"component_hint": "au-pair", "prior_definition_fa": "کسی که در خانواده ای در کشور خارجی کار و زندگی می کند", "prior_example": "", "prior_headword": "das Au-Pair, -s", "prior_level_tag": "Aspekte_B1+/B2::17_B1+:_9_–_Endlich_Urlaub", "source_csv_ordinal": 1198}], "publisher_alphabetical_witness_only": false, "reason_de": "Duden bezeichnet Au-pair als Kurzform von Au-pair-Mädchen. Der C1-Ausdruck kann als lexikalische Variante mit weiblicher Referenz vermerkt werden, statt vorschnell eine zweite Karte anzulegen.", "reason_fa": "صورت زنانهٔ مشخصِ همان Au-pair؛ جنسیت را به‌صورت یادداشت حفظ کن.", "scoped_decision": "PROVISIONAL_MERGE_VARIANT_GENDER_NOTE", "source_index_raw_verified": true, "source_pdf_sha256": "b05c90320ad75dc19be12a374087830bd2c379206a5711e604a6aea699e189cf", "source_raw": "das Au-pair-Mädchen, -"}
