{"source_chapter_id":"ga-a1b1-ch006","source_book_id":"grammatik-aktiv-a1-b1","source_hash":"aeb7625f628105204590b20870a03e92648d49366d12b478412228c8078e4207","status":"EVIDENCE_LINKED_DRAFT","lesson":{"lesson_id":"lesson.ga-a1b1-ch006","source_chapter_id":"ga-a1b1-ch006","concept_ids":["grammar.modalverben.grundbedeutungen"],"title_de":"Kann ich oder muss ich?","cefr_labels":["A1"],"short_explanation_de":"Grundbedeutungen häufiger Modalverben.","explanation_de":"Das Kapitel unterscheidet Notwendigkeit, Fähigkeit/Möglichkeit, Erlaubnis, Verbot, höflichen Wunsch, direkten Wunsch und fremde Aufforderung/Empfehlung.","explanation_fa":"این فصل تفاوت ضرورت، توانایی/امکان، اجازه، ممنوعیت، خواستهٔ مؤدبانه، خواستهٔ مستقیم و دستور/توصیهٔ دیگران را با افعال مدال نشان می‌دهد.","learning_goals":["Modalverben nach Bedeutung auswählen","Erlaubnis, Verbot und Notwendigkeit unterscheiden","möchten, wollen und sollen passend verwenden"],"rules":[{"rule_id":"ga-a1b1-ch006-r1","statement_de":"müssen drückt Notwendigkeit ohne echte Alternative aus.","explanation_fa":"müssen ضرورت و نبودِ گزینهٔ واقعی را بیان می‌کند.","scope":"Bedeutung von müssen","positive_examples":["Ich muss heute arbeiten.","Du musst jetzt gehen.","Wir müssen warten."],"exception_ids":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: Bedeutung von müssen"}],"origin_type":"SOURCE_ADAPTED"},{"rule_id":"ga-a1b1-ch006-r2","statement_de":"können drückt je nach Kontext erlernte Fähigkeit, Möglichkeit/Chance oder fehlendes Verbot aus.","explanation_fa":"können بسته به بافت توانایی آموخته‌شده، امکان/فرصت یا ممنوع نبودن را بیان می‌کند.","scope":"Bedeutungen von können","positive_examples":["Ich kann schwimmen.","Hier kann man essen.","Du kannst hier parken."],"exception_ids":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: Bedeutungen von können"}],"origin_type":"SOURCE_ADAPTED"},{"rule_id":"ga-a1b1-ch006-r3","statement_de":"dürfen bezeichnet Erlaubnis; nicht dürfen bezeichnet ein Verbot.","explanation_fa":"dürfen اجازه و nicht dürfen ممنوعیت را بیان می‌کند.","scope":"dürfen und nicht dürfen","positive_examples":["Du darfst heute länger fernsehen.","Hier darf man nicht rauchen.","Darf ich hereinkommen?"],"exception_ids":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: dürfen und nicht dürfen"}],"origin_type":"SOURCE_ADAPTED"},{"rule_id":"ga-a1b1-ch006-r4","statement_de":"möchten formuliert einen höflichen Wunsch; wollen formuliert einen direkten Wunsch oder eine Absicht.","explanation_fa":"möchten خواسته‌ای مؤدبانه و wollen خواستهٔ مستقیم یا قصد را بیان می‌کند.","scope":"möchten und wollen","positive_examples":["Ich möchte einen Kaffee.","Ich will morgen früher gehen.","Was möchten Sie trinken?"],"exception_ids":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: möchten und wollen"}],"origin_type":"SOURCE_ADAPTED"},{"rule_id":"ga-a1b1-ch006-r5","statement_de":"sollen kann eine Aufforderung oder Empfehlung wiedergeben, die von einer anderen Person kommt.","explanation_fa":"sollen می‌تواند دستور یا توصیه‌ای را منتقل کند که از شخص دیگری آمده است.","scope":"Bedeutung von sollen","positive_examples":["Der Arzt sagt, ich soll mehr schlafen.","Du sollst deine Mutter anrufen.","Was soll ich tun?"],"exception_ids":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: Bedeutung von sollen"}],"origin_type":"SOURCE_ADAPTED"}],"patterns":[{"pattern_id":"ga-a1b1-ch006-p1","pattern_type":"COMPARISON","title_de":"Grundbedeutungen der Modalverben","columns":["Modalverb","Kernbedeutung"],"rows":[["müssen","Notwendigkeit"],["können","Fähigkeit / Möglichkeit"],["dürfen","Erlaubnis"],["nicht dürfen","Verbot"],["möchten","höflicher Wunsch"],["wollen","direkter Wunsch / Absicht"],["sollen","Aufforderung / Empfehlung von außen"]],"notes_de":[],"notes_fa":[],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"Kapitel 6: Bedeutungstabelle"}]}],"examples":[{"example_id":"ga-a1b1-ch006-e1","text_de":"Ich muss heute noch einkaufen.","translation_fa":"من امروز هنوز باید خرید کنم.","concept_ids":["grammar.modalverben.grundbedeutungen"],"rule_ids":["ga-a1b1-ch006-r1"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch006-e2","text_de":"Kannst du Auto fahren?","translation_fa":"می‌توانی رانندگی کنی؟","concept_ids":["grammar.modalverben.grundbedeutungen"],"rule_ids":["ga-a1b1-ch006-r2"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch006-e3","text_de":"Hier darf man nicht fotografieren.","translation_fa":"اینجا اجازهٔ عکس گرفتن نیست.","concept_ids":["grammar.modalverben.grundbedeutungen"],"rule_ids":["ga-a1b1-ch006-r3"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch006-e4","text_de":"Ich möchte bitte ein Wasser.","translation_fa":"لطفاً یک آب می‌خواهم.","concept_ids":["grammar.modalverben.grundbedeutungen"],"rule_ids":["ga-a1b1-ch006-r4"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"},{"example_id":"ga-a1b1-ch006-e5","text_de":"Der Chef sagt, wir sollen pünktlich sein.","translation_fa":"رئیس می‌گوید باید سر وقت باشیم.","concept_ids":["grammar.modalverben.grundbedeutungen"],"rule_ids":["ga-a1b1-ch006-r5"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: source-supported pattern"}],"origin_type":"GENERATED","naturalness_status":"REVIEWED_DRAFT"}],"exceptions":[],"common_errors":[{"error_id":"ga-a1b1-ch006-ce1","wrong_example_de":"Hier muss man nicht rauchen.","correct_example_de":"Hier darf man nicht rauchen.","explanation_de":"Für ein Verbot verwendet man nicht dürfen, nicht müssen.","explanation_fa":"برای ممنوعیت از nicht dürfen استفاده می‌شود، نه müssen.","skill_tags":["modalverben","bedeutung"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: relevant source rule"}],"origin_type":"GENERATED"},{"error_id":"ga-a1b1-ch006-ce2","wrong_example_de":"Ich will einen Kaffee, bitte.","correct_example_de":"Ich möchte einen Kaffee, bitte.","explanation_de":"möchten ist für einen höflichen Wunsch passender.","explanation_fa":"برای خواستهٔ مؤدبانه möchten مناسب‌تر است.","skill_tags":["modalverben","hoeflichkeit"],"source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: relevant source rule"}],"origin_type":"GENERATED"}],"exercise_ids":["ga-a1b1-ch006-x1","ga-a1b1-ch006-x2"],"speaking_tasks":[],"linked_object_ids":[],"prerequisite_lesson_ids":[],"provenance":{"primary_source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"ga-a1b1-ch006: printed source page 18"},{"source_id":"grammatik-aktiv-a1-b1","printed_page":19,"pdf_page":17,"locator_note":"ga-a1b1-ch006: printed source page 19"}],"source_hash":"aeb7625f628105204590b20870a03e92648d49366d12b478412228c8078e4207","source_first":true},"qa_status":"EVIDENCE_LINKED_DRAFT"},"exercises":[{"exercise_id":"ga-a1b1-ch006-x1","lesson_id":"lesson.ga-a1b1-ch006","exercise_type":"MULTIPLE_CHOICE","prompt_de":"Wählen Sie das Modalverb, das zur Bedeutung passt.","answer_spec":{"mode":"single_choice"},"feedback_rules":["Bedeutung bestimmen","Erlaubnis/Verbot/Notwendigkeit unterscheiden"],"skill_tags":["modalverben","bedeutung"],"target_object_ids":["ga-a1b1-ch006-p1"],"difficulty":"A1","source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":18,"pdf_page":16,"locator_note":"Kapitel 6 Bedeutungsübungen"}],"origin_type":"SOURCE_ADAPTED"},{"exercise_id":"ga-a1b1-ch006-x2","lesson_id":"lesson.ga-a1b1-ch006","exercise_type":"FILL_GAP","prompt_de":"Ergänzen Sie müssen, können, dürfen, möchten, wollen oder sollen.","answer_spec":{"mode":"single_modal"},"feedback_rules":["Kontextbedeutung prüfen"],"skill_tags":["modalverben","gebrauch"],"target_object_ids":["ga-a1b1-ch006-p1"],"difficulty":"A1","source_refs":[{"source_id":"grammatik-aktiv-a1-b1","printed_page":19,"pdf_page":17,"locator_note":"Kapitel 6 Übungen"}],"origin_type":"SOURCE_ADAPTED"}],"evidence_status":{"source_pages_reviewed":[18,19],"source_pdf_pages":[16,17],"external_evidence_used":false,"source_major_rule_capture":"COMPLETE_FOR_CHAPTER_DRAFT","notes":"Rules/patterns are source-adapted; learner examples and error items are newly generated."}}